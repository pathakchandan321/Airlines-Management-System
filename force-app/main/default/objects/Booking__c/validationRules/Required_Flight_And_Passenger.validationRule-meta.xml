<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Flight_And_Passenger</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Flight__c), ISBLANK(Passenger__c), ISBLANK(Seat_Number__c))</errorConditionFormula>
    <errorMessage>Flight, Passenger, and Seat Number are required for a booking.</errorMessage>
</ValidationRule>
