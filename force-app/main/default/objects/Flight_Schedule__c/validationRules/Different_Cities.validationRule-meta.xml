<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Different_Cities</fullName>
    <active>true</active>
    <errorConditionFormula>TEXT(Source_Name__c) = TEXT(Destination_Name__c)</errorConditionFormula>
    <errorDisplayField>Destination_Name__c</errorDisplayField>
    <errorMessage>Source and destination cities must be different.</errorMessage>
</ValidationRule>
